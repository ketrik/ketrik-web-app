{
	"url": "/connections-catalog.json",

	"data2": {
		"article": {
			"type": "remote",
			"url": "/connections-catalog.json"
		}
	},
	"config": {
		"header": "Add Connection",
		"isFullSize": false,
		"maxWidth": "md",
		"childComponent": "DisplayData",
		"dataKey": "catalog",
		"groups": [
			{
				"id": "connection",
				"itemSize": { "sm": 2 },
				"items": [
					{
						"cardType": "actionCard",
						"cardActionUrl": "/connections/new/${id}",
						"cardProps": {
							"variant": "outlined",
							"sx": {
								"borderRadius": "12px",
								"transition": "border-color 0.2s, box-shadow 0.2s",
								"&:hover": {
									"borderColor": "primary.main",
									"boxShadow": 2
								}
							}
						},
						"cardConfig": [
							{
								"type": "cardHeader",
								"map": {
									"icon": "avatar",
									"displayName": "title",
									"categoryLabel": "subheader"
								},

								"defaults": {
									"avatar": { "label": "W" },
									"title": "title",
									"subheader": "test subheader",
									"disableTypography": false
								}
							}
						]
					}
				]
			}
		]
	}
}
