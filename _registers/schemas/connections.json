{
	"dataPath": {
		"path": "users/${uid}/context/connections"
	},

	"config": {
		"header": "Connections",
		"isFullSize": false,

		"groups": [
			{
				"id": "connections",
				"itemSize": 12,
				"items": [
					{
						"cardConfig": [
							{
								"type": "cardAction",
								"sx": {
									"justifyContent": "flex-end"
								},
								"buttons": [
									{
										"label": "Add Connection",
										"color": "primary",
										"variant": "contained",
										"startIcon": "Plus",
										"href": "/connections/new"
									}
								]
							},
							{
								"type": "cardContent",
								"dataKey": "connections",
								"dataToArray": true,

								"contentConfig": {
									"density": "compact",
									"contentType": "DataGridContent",
									"sortModel": [{ "field": "createdAt", "sort": "desc" }],
									"columns": ["logo", "id", "name", "status", "createdAt"],
									"headerTitles": {
										"logo": " ",
										"id": "ID",
										"name": "Name",
										"status": "Status",
										"createdAt": "Created At"
									},
									"idColumnName": "id",

									"columnsVisuals": {
										"logo": "icon",
										"status": "chip"
									},
									"columnWidths": {
										"logo": 40,
										"id": 200,
										"createdAt": 100
									},
									"columnsAlign": {
										"logo": "center",
										"status": "center",
										"createdAt": "center"
									},
									"columnsFlex": {
										"name": 1
									},
									"dataFormatters": {
										"createdAt": "ago"
									}
								}
							}
						]
					}
				]
			}
		]
	}
}
